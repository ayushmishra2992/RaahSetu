# Root .env — used only by docker-compose.yml. Copy to `.env` (never commit it).
POSTGRES_PASSWORD="CHANGE_ME"
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
SEED_DEMO="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Optional location search (address autocomplete + "Use pin's address").
# Leave "none" to disable; set "locationiq" and your own LocationIQ access token to enable.
# The key is used only by the backend container and never reaches the browser.
PLACES_PROVIDER="none"
PLACES_API_KEY=""
