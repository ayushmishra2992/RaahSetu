# ─── RaahSetu frontend environment ───────────────────────────────────────────
# Copy to `.env.local` (never commit it). Only needed if the backend is not on
# http://localhost:5000. Read by next.config.ts at dev/build time.
BACKEND_URL="http://localhost:5000"

# Shows one-click demo logins on the login page (uses the seeded demo users).
# Set to "false" for a real deployment. Inlined at build time.
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Map tiles (Leaflet) ─────────────────────────────────────────────────────
# Tile URL template ({z}/{x}/{y}; https only). Leave unset to use OpenStreetMap's
# standard tiles. Set to "none" to disable tiles and show the schematic map.
# OSM's tile servers are for light use only (operations.osmfoundation.org/policies/tiles):
# for production traffic point this at another provider or a self-hosted tile server.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# HTML attribution shown on every map (cannot be blank; defaults to the OSM credit).
# Must credit OpenStreetMap whenever OSM data is used.
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
# Optional maximum zoom supported by the tile server (default 19).
# NEXT_PUBLIC_MAP_MAX_ZOOM="19"
