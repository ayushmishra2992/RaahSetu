# ─── RaahSetu backend environment ────────────────────────────────────────────
# Copy to `.env` (never commit `.env`) and replace the placeholders.

# PostgreSQL 15+ connection string. Create the database first (see README).
DATABASE_URL="postgresql://raahsetu:CHANGE_ME@localhost:5432/raahsetu?schema=public"

# Separate database used only by the integration tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://raahsetu:CHANGE_ME@localhost:5432/raahsetu_test?schema=public"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="8h"

PORT=5000
NODE_ENV="development"

# Frontend origin(s) allowed by CORS (comma separated) and the public URL used in QR codes.
CORS_ORIGIN="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Set to true only when serving over HTTPS.
COOKIE_SECURE="false"

# Private directory for uploaded compliance documents (never served statically).
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
AUTH_RATE_LIMIT_PER_15_MIN=50

# Only for a hosted *demo* deployment: lets `npm run db:seed` run when NODE_ENV=production.
# Never set this on a deployment holding real company data.
ALLOW_DEMO_SEED="false"
