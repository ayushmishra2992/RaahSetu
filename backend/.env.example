# ─── RaahSetu backend environment ────────────────────────────────────────────
# Copy to `.env` (never commit `.env`) and replace the placeholders.

# PostgreSQL 15+ connection string. Create the database first (see README).
DATABASE_URL="postgresql://raahsetu:CHANGE_ME@localhost:5432/raahsetu?schema=public"

# Separate database used only by the integration tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://raahsetu:CHANGE_ME@localhost:5432/raahsetu_test?schema=public"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="8h"

PORT=5000
NODE_ENV="development"

# Frontend origin(s) allowed by CORS (comma separated) and the public URL used in QR codes.
CORS_ORIGIN="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Set to true only when serving over HTTPS.
COOKIE_SECURE="false"

# Private directory for uploaded compliance documents (never served statically).
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Document storage: "local" (UPLOAD_DIR; NOT persistent on Render's free plan) or "s3"
# (any S3-compatible PRIVATE bucket: AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# See docs/DOCUMENTS_AND_COMPLIANCE.md. Never commit real keys.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Lifetime of signed document download links (seconds).
SIGNED_URL_TTL_SECONDS=300
AUTH_RATE_LIMIT_PER_15_MIN=50

# Only for a hosted *demo* deployment: lets `npm run db:seed` run when NODE_ENV=production.
# Never set this on a deployment holding real company data.
ALLOW_DEMO_SEED="false"

# ─── Location search (optional) ──────────────────────────────────────────────
# Address/place autocomplete for the location picker. The key stays on the
# server: the browser calls /api/places/*, never the provider directly.
#   none        search off; users place the pin on the map or type coordinates
#   locationiq  LocationIQ autocomplete (OpenStreetMap data)
#   geoapify    Geoapify address autocomplete (OpenStreetMap data)
# Restrict the key in the provider's dashboard (allowed server IPs / referrers)
# and set a daily quota. Paid plans may be needed for production; see
# docs/INSTALLATION.md ("Enable location search").
PLACES_PROVIDER=none
PLACES_API_KEY=
# Optional fallback, used only when the primary provider fails (errors, limits,
# timeouts), never when it simply finds nothing. Attribution follows whichever answered.
PLACES_FALLBACK_PROVIDER=none
PLACES_FALLBACK_API_KEY=
# Two-letter country filter for suggestions.
PLACES_COUNTRY=in
# Searches allowed per company per minute (each keystroke pause is one search).
PLACES_RATE_LIMIT_PER_MIN=120
